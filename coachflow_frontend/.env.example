# Dev : laisser commenté → utilise le proxy CRA (cf. "proxy" dans package.json)
# Prod : URL HTTPS de l'API (ex: https://api.trainflow.fr/api)
# REACT_APP_API_URL=http://127.0.0.1:8000/api

REACT_APP_GOOGLE_CLIENT_ID=

# ── SENTRY (monitoring d'erreurs) ─────────────────────────────────────────────
# Crée un projet React sur https://sentry.io et copie le DSN ici.
# Laisser vide pour désactiver complètement Sentry côté front.
REACT_APP_SENTRY_DSN=
REACT_APP_SENTRY_ENVIRONMENT=production
# REACT_APP_SENTRY_RELEASE=                 # ex: commit SHA en CI
# REACT_APP_SENTRY_TRACES_SAMPLE_RATE=0.1
