# Cron du user `coachflow` (crontab -e en tant que coachflow)
# Tous les chemins sont absolus pour éviter les surprises PATH.

# Rappels séances J-1 — tous les jours à 18h
0 18 * * * cd /opt/coachflow && docker compose exec -T backend python manage.py send_rappels >> /var/log/coachflow/cron.log 2>&1

# Purge des comptes soft-deleted depuis 30j — chaque nuit à 3h
0 3 * * * cd /opt/coachflow && docker compose exec -T backend python manage.py purge_deleted_accounts >> /var/log/coachflow/cron.log 2>&1

# Backup base + media — chaque nuit à 4h (24h après crons critiques)
0 4 * * * cd /opt/coachflow && docker compose exec -T backend python manage.py backup_db >> /var/log/coachflow/cron.log 2>&1
