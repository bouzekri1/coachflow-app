# ── DJANGO ──────────────────────────────────────────────────────────────────────
# Génère une clé : python3 -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=change-moi-en-production
DEBUG=False
ALLOWED_HOSTS=api.trainflow.fr

# ── DOMAINES (utilisés par Caddy + Django + CORS) ──────────────────────────────
API_DOMAIN=api.trainflow.fr

# ── BASE DE DONNÉES PostgreSQL ─────────────────────────────────────────────────
DB_NAME=coachflow
DB_USER=coachflow
DB_PASSWORD=CHANGE-MOI
DB_HOST=db
DB_PORT=5432

# ── CORS (frontend Cloudflare Pages) ───────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://app.trainflow.fr

# ── EMAIL ────────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TrainFlow <noreply@trainflow.fr>
FRONTEND_URL=https://app.trainflow.fr

# ── PUSH NOTIFICATIONS ───────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@trainflow.fr

# ── ANTHROPIC ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── GOOGLE OAUTH ──────────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=

# ── BACKUPS ───────────────────────────────────────────────────────────────────────
BACKUP_ALERT_EMAIL=

# ── SENTRY (monitoring d'erreurs) ─────────────────────────────────────────────────
# Crée un projet Django sur https://sentry.io (gratuit jusqu'à 5k events/mois)
# et copie le DSN ici. Laisser vide en local pour désactiver.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=                          # ex: git SHA en CI
# SENTRY_TRACES_SAMPLE_RATE=0.1            # 0..1, défaut 0.1 (10%)
