# ── DJANGO ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-moi-en-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ── BASE DE DONNÉES (PostgreSQL en prod) ────────────────────────────────────────
# DB_NAME=coachflow
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ── CORS ────────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── EMAIL ────────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CoachFlow <noreply@coachflow.fr>
FRONTEND_URL=http://localhost:3000

# ── PUSH NOTIFICATIONS ───────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@coachflow.fr

# ── ANTHROPIC ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── GOOGLE OAUTH ──────────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=

# ── BACKUPS ───────────────────────────────────────────────────────────────────────
BACKUP_ALERT_EMAIL=

# ── SENTRY (monitoring d'erreurs) ─────────────────────────────────────────────────
# Crée un projet Django sur https://sentry.io (gratuit jusqu'à 5k events/mois)
# et copie le DSN ici. Laisser vide en local pour désactiver.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=                          # ex: git SHA en CI
# SENTRY_TRACES_SAMPLE_RATE=0.1            # 0..1, défaut 0.1 (10%)
