{$API_DOMAIN} {
    encode gzip zstd

    # Limite uploads (cohérent avec DATA_UPLOAD_MAX_MEMORY_SIZE Django)
    request_body {
        max_size 10MB
    }

    # Sert /media/ et /static/ directement (évite de passer par Django)
    handle_path /media/* {
        root * /srv/media
        file_server
    }
    handle_path /static/* {
        root * /srv/static
        file_server
    }

    # Tout le reste va à Django
    reverse_proxy backend:8000 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-For {remote_host}
        header_up Host {host}
    }

    # En-têtes sécurité
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
